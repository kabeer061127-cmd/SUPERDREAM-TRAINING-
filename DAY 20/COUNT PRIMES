class Solution {
    public int countPrimes(int n) {
        if (n == 0 || n == 1 || n == 2) return 0;
        boolean[] composite = new boolean[n];
        int cnt = 0;
        for (int i = 2; i < n; i++) {
            if (!composite[i]) {
                cnt++;
                for (int j = i + i; j < n; j += i) composite[j] = true;
            }
        }
        return cnt;
    }
}
